# Copy to .env.local and fill in. Never commit the real file.

# Claude API
ANTHROPIC_API_KEY=""

# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""   # any string; type the same one when registering the webhook
WHATSAPP_APP_SECRET=""             # App settings → Basic → App secret (verifies X-Hub-Signature-256)

# PostgreSQL (Neon serverless driver)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# HTTP Basic auth for /dashboard and /api/leads
DASHBOARD_USER=""
DASHBOARD_PASSWORD=""
